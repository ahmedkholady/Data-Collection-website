# Server Configuration
PORT=5000
NODE_ENV=development
JSON_LIMIT=10mb

# Database Configuration (Option 1: Connection URL)
# DATABASE_URL=postgresql://username:password@localhost:5432/data_collection

# Database Configuration (Option 2: Individual variables)
PGHOST=localhost
PGPORT=5432
PGDATABASE=data_collection
PGUSER=postgres
PGPASSWORD=your_password_here
PGMAX_CLIENTS=10
PGIDLE_TIMEOUT_MS=30000
PGCONNECTION_TIMEOUT_MS=5000
